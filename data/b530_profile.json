  "restR": "def SIDEExplicitFormula.B321.restR : ℝ → (ℝ → ℝ) → ℝ → ℝ → ℝ :=\nfun γ₀ φ L A₀ =>\n  768 * A₀ * SIDEExplicitFormula.B321.windowA γ₀ φ ^ 2 * Real.exp L * (γ₀ ^ 2 + 1) ^ 2 *\n    SIDEExplicitFormula.B321.zeta3Sum",
  "windowA": "def SIDEExplicitFormula.B321.windowA : ℝ → (ℝ → ℝ) → ℝ :=\nfun γ₀ φ =>\n  (∫ (u : ℝ), |SIDEExplicitFormula.B321.cosWin γ₀ φ u|) +\n    ∫ (u : ℝ), |iteratedDeriv 4 (SIDEExplicitFormula.B321.cosWin γ₀ φ) u|",
  "zeta3Sum": "def SIDEExplicitFormula.B321.zeta3Sum : ℝ :=\n∑' (m : ℤ), 1 / (1 + |↑m|) ^ 3",
  "f4_needs": "def SIDEExplicitFormula.B321.f4_needs : ℝ → Prop :=\nfun δ => ∃ C, 0 < C ∧ ∃ L₀, ∀ L ≥ L₀, Real.exp L ≤ C * Real.exp (2 * δ * L)",
  "HMax": "def SIDEExplicitFormula.B321.HMax : Zeta23.ZeroConfig → Prop :=\nfun Z => ∃ ρ ∈ Z.carrier, ∀ ρ' ∈ Z.carrier, ρ'.re ≤ ρ.re",
  "HCount": "def SIDEExplicitFormula.B321.HCount : Zeta23.ZeroConfig → ℝ → Prop :=\nfun Z A₀ => 1 ≤ A₀ ∧ ∀ (t : ℝ), ↑(Z.N t (t + 1)) ≤ A₀ * Real.log (|t| + 3)",
  "HStrip": "def SIDEExplicitFormula.B321.HStrip : Zeta23.ZeroConfig → Prop :=\nfun Z => ∀ ρ ∈ Z.carrier, 0 < ρ.re ∧ ρ.re < 1",
